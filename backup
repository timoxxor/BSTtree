void order_arr(Node* self, int* arr, int* idx) {
			if (self == nullptr) return;
		
			order_arr(self->left, arr, idx);
		
			arr[*idx] = self->key;
			(*idx)++;
		
			order_arr(self->right, arr, idx);
		
		} 
		
		Node* build_balanced_BST(int* arr, int start, int end) {
			if (start > end) return nullptr;
		
			int mid = (start + end) / 2;
			Node* root = create_node(arr[mid]);
			
			root->left = build_balanced_BST(arr, start, mid - 1);
			root->right = build_balanced_BST(arr, mid + 1, end);
		
			return root;
		}
		
		Node* balanced_BST(Node* self) {
			size_t size = count_nodes(self);
			int* arr = (int*)malloc(sizeof(int)*size);
			
			int idx = 0;
			order_arr(self, arr, &idx);
		
			return build_balanced_BST(arr, 0, size - 1);
		}


		int count_nodes(Node* self) {
			if (self == nullptr) return 0;
			return 1 + count_nodes(self->left) + count_nodes(self->right);
		}
		
